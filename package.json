{
  "name": "@shayc/react-built-in-ai",
  "version": "0.11.4",
  "description": "React hooks for the browser's built-in AI APIs (Translator, Summarizer, Writer, Rewriter, Proofreader, Language Detector, Prompt) — on-device models, no API key, no server.",
  "license": "MIT",
  "author": "Shay Cojocaru <shayc@outlook.com>",
  "homepage": "https://github.com/shayc/react-built-in-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayc/react-built-in-ai.git"
  },
  "bugs": {
    "url": "https://github.com/shayc/react-built-in-ai/issues"
  },
  "keywords": [
    "react",
    "react-hooks",
    "built-in-ai",
    "ai-translator",
    "ai-rewriter",
    "ai-proofreader",
    "ai-summarizer",
    "ai-writer",
    "ai-language-detector",
    "ai-language-model"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "dependencies": {
    "@types/dom-chromium-ai": "^0.0.17"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
