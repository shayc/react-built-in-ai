{
  "name": "@shayc/react-built-in-ai",
  "version": "0.11.5",
  "description": "React hooks for the browser's built-in AI APIs (Translator, Summarizer, Writer, Rewriter, Proofreader, Language Detector, Prompt) — on-device models, no API key, no server.",
  "license": "MIT",
  "author": "Shay Cojocaru <shayc@outlook.com>",
  "homepage": "https://github.com/shayc/react-built-in-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayc/react-built-in-ai.git"
  },
  "bugs": {
    "url": "https://github.com/shayc/react-built-in-ai/issues"
  },
  "keywords": [
    "react",
    "react-hooks",
    "built-in-ai",
    "ai-translator",
    "ai-rewriter",
    "ai-proofreader",
    "ai-summarizer",
    "ai-writer",
    "ai-language-detector",
    "ai-language-model"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "dependencies": {
    "@types/dom-chromium-ai": "^0.0.17"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "publint": "^0.3.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
